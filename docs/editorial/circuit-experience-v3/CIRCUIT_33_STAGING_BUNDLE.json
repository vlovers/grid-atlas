    {
      "circuit_id": "dallas",
      "short_story_source": "apps/web/src/components/editorial/circuit-final33-stories.json",
      "events": [
        {
          "year": 1984,
          "draft_path": "docs/editorial/circuit-experience-v3/FOUR_CONTEXTUAL_HISTORY_STORIES_20261028.md",
