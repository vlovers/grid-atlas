      "short_story_source": "apps/web/src/components/editorial/circuit-next20-stories.json",
      "events": [
        {
          "year": 1959,
          "draft_path": "docs/editorial/circuit-experience-v3/EXPANSION_FINAL_THIRTEEN_CHAPTERS_20261028.md",
