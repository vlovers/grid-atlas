# Documentation template only. Neither service automatically loads this file.
# Inject actual values through the host's secret/environment management.
NODE_ENV=production

# API: intentionally blank; startup must fail until explicitly configured.
# Use a dedicated least-privilege runtime user and provider-verified PostgreSQL TLS.
# Never use the local Compose password or disable certificate verification.
DATABASE_URL=
HOST=127.0.0.1
PORT=3001

# Next.js server-only API origin; adjust for the private service network.
API_BASE_URL=http://127.0.0.1:3001
# Intentionally blank: previews remain noindex. Set the approved public HTTPS
# origin (no path, query or credentials) only after the launch gates are reviewed.
SITE_URL=
