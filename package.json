{
  "name": "grid-atlas",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check-foundation.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test:integration": "pnpm --filter @grid-atlas/api test:integration",
    "test:browser": "GRID_ATLAS_NEXT_DIST_DIR=.next-test pnpm build && GRID_ATLAS_NEXT_DIST_DIR=.next-test playwright test",
    "check:docs": "python3 scripts/audit-doc-links.py",
    "audit:repo": "python3 scripts/audit-repository-assets.py",
    "audit:media": "node scripts/audit-media-readiness.mjs",
    "audit:editorial": "node scripts/editorial-content-coverage.mjs",
    "audit:editorial:strict": "node scripts/editorial-content-coverage.mjs --require-evidence",
    "audit:editorial:corroboration": "node scripts/editorial-content-coverage.mjs --require-corroboration",
    "audit:editorial:narratives": "node scripts/editorial-narrative-audit.mjs",
    "audit:editorial:queue": "node scripts/editorial-corroboration-queue.mjs",
    "audit:editorial:provenance": "node scripts/editorial-provenance-audit.mjs --summary",
    "review:circuits": "node scripts/export-circuit-expansion-review.mjs --format=json",
    "review:circuits:html": "node scripts/export-circuit-expansion-review.mjs --format=html",
    "review:circuits:claims": "node scripts/circuit-claim-review-queue.mjs --format=json",
    "review:circuits:claims:md": "node scripts/circuit-claim-review-queue.mjs --format=markdown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.5.28",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  }
}
